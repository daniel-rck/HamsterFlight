{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!dist", "!reference", "!**/*.as"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["src/sim/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "src/sim must stay headless and deterministic.",
                  "document": "src/sim must stay headless and deterministic.",
                  "navigator": "src/sim must stay headless and deterministic.",
                  "performance": "Time must not enter the sim; it steps in fixed 50 ms ticks.",
                  "localStorage": "Persistence belongs in src/persistence.",
                  "requestAnimationFrame": "The loop drives the sim, not the other way round.",
                  "fetch": "src/sim must stay headless and deterministic."
                }
              }
            }
          }
        }
      }
    }
  ]
}
