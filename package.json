{
  "name": "hamsterflight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Faithful browser port of the Flash game Flight of the Hamsters, reconstructed from bytecode analysis",
  "keywords": [
    "game",
    "flash",
    "port",
    "canvas",
    "webgl",
    "pixijs",
    "typescript",
    "cloudflare-workers"
  ],
  "author": "daniel-rck",
  "license": "MIT",
  "homepage": "https://hamsterflight.daniel-rck.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-rck/HamsterFlight.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-rck/HamsterFlight/issues"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sim.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:purity": "node scripts/check-sim-purity.ts",
    "check:assets": "node scripts/check-assets.ts",
    "check:bundle": "node scripts/bundle-report.ts --check",
    "check:cf": "node scripts/check-cloudflare.ts",
    "bundle:report": "node scripts/bundle-report.ts",
    "smoke": "node scripts/smoke.ts",
    "bench": "node scripts/bench-strategies.ts",
    "bench:renderers": "node scripts/bench-renderers.ts",
    "audit": "bun audit",
    "verify": "bun run lint && bun run check:purity && bun run check:assets && bun run typecheck && bun run test && bun run build && bun run check:bundle",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "webBase": {
    "version": "0.3.1"
  }
}
