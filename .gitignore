# dependencies. This project uses Bun (bun.lock); stray lockfiles from other
# package managers are ignored so they cannot drift alongside it.
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# build output
dist/
.vite/

# Cloudflare / wrangler
.wrangler/
.dev.vars

# Original SWF assets extracted for measurement only.
# NEVER commit or ship these - see reference/README.md
reference/extracted/
*.swf

# tooling
__pycache__/
*.py[cod]
.DS_Store
*.log

# test and typecheck output
coverage/
*.tsbuildinfo
test-results/
playwright-report/

# local secrets and editors
.env
.env.*
.dev.vars.*
.idea/
.claude/
